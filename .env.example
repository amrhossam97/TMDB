# Copy this file to .env and fill in your own values.

# App
MODE_APP=DEV
LOGGING=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=tmdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# TMDB (get your keys from https://www.themoviedb.org/settings/api)
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p/original
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_TOKEN=your_tmdb_read_access_token

# Auth
JWT_SECRET_KEY=change_me
JWT_EXPIRE_MS=3600
IGNORE_JWT_EXPIRE=false

# Encryption (32-char key, 16-char IV)
ENCRIPT_KEY=change_me_32_characters_long_key
ENCRIPT_IV=change_me_16_chr

# HTTP client
AXIOS_TIMEOUT=5000
AXIOS_REDIRECTS=5
